# PostgreSQL Database Connection (Required on Vercel / Neon / Supabase / Railway)
DATABASE_URL=

# Optional Firebase Project Override (Defaults to firebase-applet-config.json)
FIREBASE_PROJECT_ID=

# Server-side Admin override passcode and initial Admin email for QUIZVERSE Admin Dashboard
ADMIN_PASSCODE=
ADMIN_EMAIL=

# AI Studio Runtime Variables (Auto-injected in AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
